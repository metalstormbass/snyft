<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.test</groupId>
    <artifactId>import-bom-project</artifactId>
    <version>1.0.0</version>

    <properties>
        <spring.boot.version>3.0.0</spring.boot.version>
        <local.version>2.0.0</local.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Imported BOM — versions come from this external POM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Regular managed dep (not a BOM import) -->
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>local-managed</artifactId>
                <version>${local.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Version from imported BOM (spring-boot-dependencies) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Version from local dependencyManagement -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>local-managed</artifactId>
        </dependency>
        <!-- Explicit version -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>31.1-jre</version>
        </dependency>
    </dependencies>
</project>
